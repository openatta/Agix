{
  "$defs": {
    "CloseReason": {
      "enum": [
        "closed",
        "engine_stopped"
      ],
      "type": "string"
    },
    "DaemonEvent": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "mcp_connected",
              "type": "string"
            },
            "server": {
              "type": "string"
            },
            "tool_count": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "transport": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "server",
            "transport",
            "tool_count"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "type": "string"
            },
            "kind": {
              "const": "mcp_connect_failed",
              "type": "string"
            },
            "server": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "server",
            "error"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "mcp_auth_required",
              "type": "string"
            },
            "scopes": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "server": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "server",
            "scopes"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "mcp_auth_completed",
              "type": "string"
            },
            "server": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "server"
          ],
          "type": "object"
        },
        {
          "properties": {
            "error": {
              "type": "string"
            },
            "kind": {
              "const": "mcp_auth_failed",
              "type": "string"
            },
            "server": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "server",
            "error"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "import_detected",
              "type": "string"
            },
            "sources": {
              "items": {
                "$ref": "#/$defs/ImportSource"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "sources"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "session_created",
              "type": "string"
            },
            "project_root": {
              "type": [
                "string",
                "null"
              ]
            },
            "scene": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "session_id",
            "scene"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "session_resumed",
              "type": "string"
            },
            "project_root": {
              "type": [
                "string",
                "null"
              ]
            },
            "scene": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "session_id",
            "scene"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "session_evicted",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/EvictReason"
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "session_id",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "session_closed",
              "type": "string"
            },
            "reason": {
              "$ref": "#/$defs/CloseReason"
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "session_id",
            "reason"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "session_deleted",
              "type": "string"
            },
            "parent_session_id": {
              "description": "Set on a sidechain deleted along with its parent.",
              "type": [
                "string",
                "null"
              ]
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "session_id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "initiator": {
              "$ref": "#/$defs/Initiator"
            },
            "kind": {
              "const": "turn_started",
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "session_id",
            "turn_id",
            "initiator"
          ],
          "type": "object"
        },
        {
          "properties": {
            "initiator": {
              "$ref": "#/$defs/Initiator"
            },
            "kind": {
              "const": "turn_completed",
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "turn_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "session_id",
            "turn_id",
            "initiator"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "project_trust_changed",
              "type": "string"
            },
            "project_root": {
              "type": "string"
            },
            "trust": {
              "description": "`none`, `trusted` or `untrusted`, as `project.status` reports it.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "project_root",
            "trust"
          ],
          "type": "object"
        }
      ]
    },
    "EvictReason": {
      "oneOf": [
        {
          "enum": [
            "idle",
            "capacity"
          ],
          "type": "string"
        },
        {
          "const": "rebuild",
          "description": "The old engine of an in-place rebuild did not stop in time.",
          "type": "string"
        }
      ]
    },
    "ImportSource": {
      "properties": {
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "description"
      ],
      "type": "object"
    },
    "Initiator": {
      "description": "Who asked for a turn. A client's turn crosses no scene boundary; the\ndaemon's own turns go to sessions it already serves.",
      "enum": [
        "client",
        "schedule",
        "goal"
      ],
      "type": "string"
    },
    "PermissionRule": {
      "properties": {
        "behavior": {
          "$ref": "#/$defs/RuleBehavior"
        },
        "rule_content": {
          "description": "例：Bash 用 \"git push:*\"；Read 用 \"/etc/**\"",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/RuleSource"
        },
        "tool_name": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "behavior",
        "tool_name"
      ],
      "type": "object"
    },
    "RpcError": {
      "properties": {
        "code": {
          "format": "int32",
          "type": "integer"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "RpcRequest": {
      "properties": {
        "id": {
          "description": "Request id; we echo back. Number or string. None = notification."
        },
        "jsonrpc": {
          "default": "2.0",
          "description": "JSON-RPC version (must be \"2.0\")",
          "type": "string"
        },
        "method": {
          "description": "Method name (e.g. \"session.create\")",
          "type": "string"
        },
        "params": {
          "default": null,
          "description": "Method-specific params (object or null)"
        }
      },
      "required": [
        "method"
      ],
      "type": "object"
    },
    "RpcResponse": {
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RpcError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": true,
        "jsonrpc": {
          "type": "string"
        },
        "result": true
      },
      "required": [
        "jsonrpc",
        "id"
      ],
      "type": "object"
    },
    "RuleBehavior": {
      "enum": [
        "allow",
        "deny",
        "ask"
      ],
      "type": "string"
    },
    "RuleSource": {
      "oneOf": [
        {
          "const": "userSettings",
          "description": "`~/.agix/scenes/<scope>/settings.json`",
          "type": "string"
        },
        {
          "const": "projectSettings",
          "description": "`<git-root>/.agix/settings.json`",
          "type": "string"
        },
        {
          "const": "localSettings",
          "description": "`<git-root>/.agix/settings.local.json`",
          "type": "string"
        },
        {
          "const": "cliArg",
          "description": "CLI flag (`--permission-mode`, `--allow-tool` 等)",
          "type": "string"
        },
        {
          "const": "session",
          "description": "会话内通过 `/permissions` 命令设置",
          "type": "string"
        },
        {
          "const": "policySettings",
          "description": "部署方的 managed settings（`base::managed_settings`）",
          "type": "string"
        },
        {
          "const": "command",
          "description": "由命令展开时临时注入",
          "type": "string"
        },
        {
          "const": "plugin",
          "description": "由已安装插件贡献。卸载插件时用 `PermissionGate::remove_rules_by_source`\n整批撤销。",
          "type": "string"
        }
      ]
    },
    "ServerDaemonEvent": {
      "description": "The `daemon.event` kinds the server makes up itself rather than relays\nfrom the pool.",
      "oneOf": [
        {
          "description": "This connection read too slowly and missed `missed` notifications.",
          "properties": {
            "kind": {
              "const": "events_lagged",
              "type": "string"
            },
            "missed": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "missed"
          ],
          "type": "object"
        }
      ]
    },
    "StartAgentParams": {
      "description": "`session.startAgent`'s params.",
      "properties": {
        "allowed_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "disallowed_tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "model": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "notify_parent": {
          "default": true,
          "type": "boolean"
        },
        "output_schema": {
          "default": null
        },
        "permission_rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "type": "array"
        },
        "prompt": {
          "type": "string"
        },
        "provider": {
          "default": null,
          "description": "Refused when given: a sub-agent runs on its parent's provider.",
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": "string"
        },
        "subagent_type": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "session_id",
        "prompt"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "daemon 的 JSON-RPC 2.0 接口。语义见 docs/daemon_rpc_protocol.md;params/result 标着\"未类型化\"的,这里不做约束。带 module 的方法属于可选模块,构建里没有这个模块时答 METHOD_NOT_FOUND。daemon.auth 是连接握手,不在 methods 里(协议文档 §5.1)。",
  "errors": [
    {
      "code": -32700,
      "name": "PARSE_ERROR"
    },
    {
      "code": -32600,
      "name": "INVALID_REQUEST"
    },
    {
      "code": -32601,
      "name": "METHOD_NOT_FOUND"
    },
    {
      "code": -32602,
      "name": "INVALID_PARAMS"
    },
    {
      "code": -32603,
      "name": "INTERNAL_ERROR"
    },
    {
      "code": -32000,
      "name": "SESSION_NOT_FOUND"
    },
    {
      "code": -32002,
      "name": "ENGINE_ERROR"
    },
    {
      "code": -32003,
      "name": "UNAUTHORIZED"
    },
    {
      "code": -32006,
      "name": "SCENE_MISMATCH"
    },
    {
      "code": -32010,
      "name": "PROJECT_NOT_FOUND"
    },
    {
      "code": -32004,
      "name": "SCENE_NOT_FOUND"
    },
    {
      "code": -32009,
      "name": "SCENE_HAS_ACTIVE_SESSIONS"
    },
    {
      "code": -32014,
      "name": "SIDECHAIN_TERMINAL"
    },
    {
      "code": -32016,
      "name": "PLUGINS_DISABLED"
    },
    {
      "code": -32017,
      "name": "TOO_MANY_IN_FLIGHT"
    },
    {
      "code": -32015,
      "name": "SESSION_BUSY"
    },
    {
      "code": -32012,
      "name": "PROJECT_REQUIRED"
    },
    {
      "code": -32018,
      "name": "TASK_NOT_FOUND"
    },
    {
      "code": -32019,
      "name": "TASK_LIMIT"
    },
    {
      "code": -32020,
      "name": "MCP_SERVER_DENIED"
    },
    {
      "code": -32021,
      "name": "MCP_AUTH_FAILED"
    },
    {
      "code": -32022,
      "name": "PROJECT_UNTRUSTED"
    }
  ],
  "frames": {
    "error": {
      "$ref": "#/$defs/RpcError"
    },
    "request": {
      "$ref": "#/$defs/RpcRequest"
    },
    "response": {
      "$ref": "#/$defs/RpcResponse"
    }
  },
