package agix:plugin@0.1.0;

interface types {
  /// One tool a component exports.
  record tool-def {
    /// Unique within the plugin; the host namespaces it as
    /// `plugin__<pkg>__<name>`.
    name: string,
    /// One line. This is what ships in the model's tool list on every call,
    /// so it is deliberately the short form.
    description: string,
    /// The long usage guide, fetched on demand rather than sent every turn.
    doc: option<string>,
    /// JSON Schema for the tool's input.
    input-schema: string,
    /// Declared for scheduling only. The host does not relax permissions
    /// because a plugin says its tool is harmless.
    read-only: bool,
    concurrency-safe: bool,
  }

  /// Mirrors the host's own tool result: model-facing content, an optional
  /// structured value for programmatic consumers, and the error flag. A
  /// plugin tool is not a second-class tool, so it can express all three.
  record tool-output {
    content: string,
    structured: option<string>,
    is-error: bool,
  }

  /// What a component may answer when the host offers it a lifecycle event.
  ///
  /// Observe and veto only. There is deliberately no "rewrite this" variant:
  /// silently altering another party's tool call is a different power from
  /// refusing it, and it is not one a downloaded package gets.
  variant hook-decision {
    /// Nothing to say.
    proceed,
    /// Refuse, with a reason the user sees.
    block(string),
    /// Add an attributable note to the conversation.
    add-context(string),
  }
}

/// Services the host lends to a component. Note what is absent: there is no
/// file API here, because filesystem access is granted through WASI preopens
/// from the manifest's capability list — re-implementing path checks as host
/// functions is how those checks get subtly wrong.
interface host {
  log: func(level: string, msg: string);
  /// Stream progress for an in-flight call back to the user.
  progress: func(call-id: string, text: string);
  now-ms: func() -> u64;
  /// Subject to the manifest's `net` allowlist.
  http-request: func(
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
  ) -> result<list<u8>, string>;
  /// Subject to the manifest's `env` allowlist.
  secret: func(key: string) -> option<string>;
  /// Per-plugin key-value storage. A component gets a fresh store on every
  /// call, so anything that must outlive one call lives here — where the host
  /// can see it, clear it, and drop it when the plugin is uninstalled.
  kv-get: func(key: string) -> option<list<u8>>;
  kv-set: func(key: string, value: list<u8>);
}

interface tools {
  use types.{tool-def, tool-output};
  /// The authority on what this component provides. The manifest's `tools`
  /// list is install-time visibility; this is what the host registers.
  list-tools: func() -> list<tool-def>;
  call-tool: func(name: string, input-json: string, call-id: string) -> tool-output;
}

/// Optional. A component that does not export this does not participate in
/// the event surface, and declaring events in the manifest without exporting
/// it is a load-time error rather than a silent no-op.
interface events {
  use types.{hook-decision};
  on-event: func(event: string, payload-json: string) -> hook-decision;
}

world plugin {
  import host;
  export tools;
  export events;
  /// Called once after load with the validated user configuration.
  export init: func(config-json: string) -> result<_, string>;
}
